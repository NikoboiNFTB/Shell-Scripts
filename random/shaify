#!/usr/bin/env bash

set -euo pipefail

# This is just a dumb little thing

process_file() {
	local input=$1

	# Check file exists and is a regular file
	if [ ! -f "$input" ]; then
		echo "Error: '$input' is not a file" >&2
		return 1
	fi

	# Extract extension (if any)
	local ext=""
	if [[ "$input" == *.* ]]; then
		ext=".${input##*.}"
	fi

	# Compute hash
	local hash
	hash=$(sha256sum -- "$input" | awk '{print $1}')

	# New filename
	local new_name="${hash}${ext}"

	# Prevent overwrite
	if [ -e "$new_name" ]; then
		echo "Error: '$new_name' already exists" >&2
		return 1
	fi

	# Rename
	mv -- "$input" "$new_name"

	echo "Renamed '$input' -> '$new_name'"
}

# Process each argument
for input in "$@"; do
	process_file "$input" || true
done
