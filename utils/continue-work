#!/usr/bin/env bash

set -euo pipefail

# Config
database="$HOME/.config/continue-work.json"

# Apps
browser="firefox"
terminal="gnome-terminal"
code_editor="codium"
file_manager="nemo"

# -------------------------------------------------------------------
# Setup
# -------------------------------------------------------------------

mkdir -p "$(dirname "$database")"

if [[ ! -f "$database" ]]; then
	jq -n '{entries: []}' >"$database"
fi

# -------------------------------------------------------------------
# Functions
# -------------------------------------------------------------------

usage() {
	cat <<EOF
Usage:
  $0 add <type> <value>
  $0 remove <type> <value>
  $0 show [type]
  $0

Types:
  link       Open with browser
  terminal   Open terminal at directory
  codium     Open directory/file in Codeium
  files      Open with file manager

Examples:
  $0 add link 'https://example.com'
  $0 remove link 'https://example.com'
  $0 add terminal '\$HOME/Documents'
  $0 add codium '\$HOME/GitHub/project'
  $0 add files '\$HOME/Downloads'
  $0 show
  $0 show all
  $0 show terminal
EOF
}

show_entries() {
	local type="${1:-all}"

	if [[ "$type" == "all" ]]; then
		jq -r '
			.entries
			| group_by(.type)
			| .[]
			| "# \(. [0].type)",
			  (.[] | "  \(.value)"),
			  ""
		' "$database"
	else
		jq -r --arg type "$type" '
			.entries
			| map(select(.type == $type))
			| if length == 0 then
				"No entries of type: \($type)"
			  else
				"# \($type)",
				(.[] | "  \(.value)")
			  end
		' "$database"
	fi
}

add_entry() {
	local type="$1"
	local value="$2"

	jq \
		--arg type "$type" \
		--arg value "$value" \
		'
		if any(.entries[]; .type == $type and .value == $value) then
			.
		else
			.entries += [{
				type: $type,
				value: $value
			}]
		end
		' \
		"$database" >"$database.tmp"

	mv "$database.tmp" "$database"
}

remove_entry() {
	local type="$1"
	local value="$2"

	jq \
		--arg type "$type" \
		--arg value "$value" \
		'
		.entries |= map(
			select(.type != $type or .value != $value)
		)
		' \
		"$database" >"$database.tmp"

	mv "$database.tmp" "$database"
}

open_entry() {
	local type="$1"
	local value="$2"

	case "$type" in
	link)
		"$browser" --new-tab "$value" &
		;;

	terminal)
		"$terminal" --working-directory="$value" &
		;;

	codium)
		"$code_editor" "$value" &
		;;

	files)
		"$file_manager" "$value" &
		;;

	*)
		echo "Unknown entry type: $type" >&2
		;;
	esac
}

open_all() {
	while IFS=$'\t' read -r type value; do
		open_entry "$type" "$value"
	done < <(
		jq -r '.entries[] | [.type, .value] | @tsv' "$database"
	)
}

# -------------------------------------------------------------------
# Commands
# -------------------------------------------------------------------

if [[ $# -eq 0 ]]; then
	open_all
	exit 0
fi

case "$1" in
add)
	if [[ $# -ne 3 ]]; then
		usage
		exit 1
	fi

	add_entry "$2" "$3"
	;;

remove)
	if [[ $# -ne 3 ]]; then
		usage
		exit 1
	fi

	remove_entry "$2" "$3"
	;;

show)
	if [[ $# -gt 2 ]]; then
		usage
		exit 1
	fi

	show_entries "${2:-all}"
	;;

-h | --help | help)
	usage
	;;

*)
	echo "Unknown command: $1" >&2
	echo
	usage
	exit 1
	;;
esac
